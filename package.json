{
  "name": "package",
  "version": "1.0.0",
  "description": "mock backend order mangement system",
  "main": "server.js",
  "author": "matt",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "echo 'No build step required for Node.js'",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\"",
    "validate": "npm run lint && npm run format:check && npm run test",
    "docker:compose:up": "docker-compose up -d",
  "docker:compose:down": "docker-compose down",
  "docker:compose:logs": "docker-compose logs -f",
  "docker:compose:build": "docker-compose build",
  "docker:compose:restart": "docker-compose restart",
  "docker:compose:dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up",
  "docker:compose:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up -d",
  "docker:compose:clean": "docker-compose down -v --rmi all"

},
  "dependencies": {
    "body-parser": "^2.2.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.11",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "jest": "^30.2.0",
    "@jest/globals": "^30.2.0"
  }
}
